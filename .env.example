# PostgreSQL. Use a separate database for development, testing, preview and production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ferraro_manager"
# Sólo para `prisma migrate dev` cuando el proveedor entrega una base shadow separada.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ferraro_manager_shadow"

# Generate at least 32 random bytes for every environment.
BETTER_AUTH_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"

# One-time/idempotent internal ADMIN bootstrap. Never expose these in client code.
BOOTSTRAP_ADMIN_NAME="Administrador Ferraro"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-unique-password"

# Central product configuration.
BUSINESS_TIME_ZONE="America/Argentina/Buenos_Aires"
BUSINESS_CURRENCY="USD"
