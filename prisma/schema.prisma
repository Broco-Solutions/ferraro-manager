generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id            String           @id @default(uuid()) @db.Uuid
  name          String
  email         String           @unique
  emailVerified Boolean          @default(false)
  image         String?
  role          UserRole         @default(STAFF)
  active        Boolean          @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sessions      Session[]
  accounts      Account[]
  idempotency   IdempotencyKey[]

  @@index([active])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

model IdempotencyKey {
  id              String   @id @default(uuid()) @db.Uuid
  key             String
  operation       String
  actorId         String?  @db.Uuid
  actor           User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  requestHash     String
  resultReference String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@unique([operation, key])
  @@index([actorId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
