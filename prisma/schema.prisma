generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum VehicleClass {
  SEDAN
  SUV
  PICKUP
  OTHER
}

enum ServiceVariantType {
  VEHICLE_CLASS
  MODEL_EXCEPTION
}

enum ServiceCaseOrigin {
  DIRECT_APPOINTMENT
  DIRECT_JOB
  ACCEPTED_QUOTE
}

enum AppointmentStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model User {
  id                       String                @id @default(uuid()) @db.Uuid
  name                     String
  email                    String                @unique
  emailVerified            Boolean               @default(false)
  image                    String?
  role                     UserRole              @default(STAFF)
  active                   Boolean               @default(true)
  lastLoginAt              DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  idempotency              IdempotencyKey[]
  clientsCreated           Client[]              @relation("ClientCreatedBy")
  clientsUpdated           Client[]              @relation("ClientUpdatedBy")
  vehiclesCreated          Vehicle[]             @relation("VehicleCreatedBy")
  vehiclesUpdated          Vehicle[]             @relation("VehicleUpdatedBy")
  serviceCategoriesCreated ServiceCategory[]     @relation("ServiceCategoryCreatedBy")
  serviceCategoriesUpdated ServiceCategory[]     @relation("ServiceCategoryUpdatedBy")
  servicesCreated          Service[]             @relation("ServiceCreatedBy")
  servicesUpdated          Service[]             @relation("ServiceUpdatedBy")
  serviceVariantsCreated   ServiceVariant[]      @relation("ServiceVariantCreatedBy")
  serviceVariantsUpdated   ServiceVariant[]      @relation("ServiceVariantUpdatedBy")
  serviceCasesCreated      ServiceCase[]         @relation("ServiceCaseCreatedBy")
  appointmentsCreated      Appointment[]         @relation("AppointmentCreatedBy")
  appointmentsUpdated      Appointment[]         @relation("AppointmentUpdatedBy")
  appointmentAssignments   AppointmentEmployee[]
  calendarBlocksCreated    CalendarBlock[]       @relation("CalendarBlockCreatedBy")
  calendarBlocksUpdated    CalendarBlock[]       @relation("CalendarBlockUpdatedBy")
  jobsCreated              Job[]                 @relation("JobCreatedBy")
  jobsUpdated              Job[]                 @relation("JobUpdatedBy")
  jobAssignments           JobEmployee[]
  quotesCreated            Quote[]               @relation("QuoteCreatedBy")
  quotesUpdated            Quote[]               @relation("QuoteUpdatedBy")

  @@index([active])
  @@map("users")
}

model Client {
  id              String        @id @default(uuid()) @db.Uuid
  displayName     String
  firstName       String?
  lastName        String?
  phone           String?
  normalizedPhone String?
  whatsapp        String?
  email           String?
  instagram       String?
  notes           String?
  active          Boolean       @default(true)
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdById     String?       @db.Uuid
  updatedById     String?       @db.Uuid
  createdBy       User?         @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?         @relation("ClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  vehicles        Vehicle[]
  serviceCases    ServiceCase[]
  quotes          Quote[]

  @@index([displayName])
  @@index([normalizedPhone])
  @@index([email])
  @@index([active, createdAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("clients")
}

model Vehicle {
  id             String        @id @default(uuid()) @db.Uuid
  clientId       String        @db.Uuid
  brand          String
  model          String
  version        String?
  year           Int?
  color          String?
  vehicleClass   VehicleClass?
  notes          String?
  coverObjectKey String?
  active         Boolean       @default(true)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?       @db.Uuid
  updatedById    String?       @db.Uuid
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy      User?         @relation("VehicleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?         @relation("VehicleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  serviceCases   ServiceCase[]
  quotes         Quote[]

  @@index([clientId, active])
  @@index([brand, model])
  @@index([createdById])
  @@index([updatedById])
  @@map("vehicles")
}

model ServiceCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdBy   User?     @relation("ServiceCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?     @relation("ServiceCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  services    Service[]

  @@unique([name])
  @@index([active, sortOrder])
  @@map("service_categories")
}

model Service {
  id                       String               @id @default(uuid()) @db.Uuid
  categoryId               String               @db.Uuid
  name                     String
  internalDescription      String?
  commercialDescription    String?
  basePriceUsd             Decimal?             @db.Decimal(19, 2)
  estimatedDurationMinutes Int?
  imageObjectKey           String?
  sortOrder                Int                  @default(0)
  active                   Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  createdById              String?              @db.Uuid
  updatedById              String?              @db.Uuid
  category                 ServiceCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants                 ServiceVariant[]
  appointmentServices      AppointmentService[]
  jobServices              JobService[]
  quoteItems               QuoteItem[]
  createdBy                User?                @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                User?                @relation("ServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([categoryId, name])
  @@index([active, sortOrder])
  @@index([categoryId, active])
  @@map("services")
}

model ServiceVariant {
  id                       String             @id @default(uuid()) @db.Uuid
  serviceId                String             @db.Uuid
  type                     ServiceVariantType
  label                    String
  vehicleClass             VehicleClass?
  matchBrand               String?
  matchModel               String?
  priceUsd                 Decimal            @db.Decimal(19, 2)
  estimatedDurationMinutes Int?
  priority                 Int                @default(0)
  active                   Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  createdById              String?            @db.Uuid
  updatedById              String?            @db.Uuid
  service                  Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdBy                User?              @relation("ServiceVariantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                User?              @relation("ServiceVariantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([serviceId, active, type, priority])
  @@map("service_variants")
}

model ServiceCase {
  id              String            @id @default(uuid()) @db.Uuid
  clientId        String            @db.Uuid
  vehicleId       String            @db.Uuid
  origin          ServiceCaseOrigin
  agreedAmountUsd Decimal?          @db.Decimal(19, 2)
  acceptedQuoteId String?           @unique @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  createdById     String?           @db.Uuid
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle         Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  createdBy       User?             @relation("ServiceCaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  acceptedQuote   Quote?            @relation(fields: [acceptedQuoteId], references: [id], onDelete: Restrict)
  appointments    Appointment[]
  jobs            Job[]

  @@index([clientId, vehicleId])
  @@index([createdById])
  @@map("service_cases")
}

model QuoteSequence {
  year      Int      @id
  nextValue Int
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("quote_sequences")
}

model Quote {
  id                 String       @id @default(uuid()) @db.Uuid
  clientId           String       @db.Uuid
  vehicleId          String       @db.Uuid
  number             String       @unique
  status             QuoteStatus  @default(DRAFT)
  issuedOn           DateTime     @db.Date
  validUntil         DateTime?    @db.Date
  notes              String?
  terms              String?
  subtotalUsd        Decimal      @db.Decimal(19, 2)
  discountUsd        Decimal      @default(0) @db.Decimal(19, 2)
  totalUsd           Decimal      @db.Decimal(19, 2)
  templateVersion    Int          @default(1)
  pdfArtifactKey     String?
  pdfSha256          String?
  pdfGeneratedAt     DateTime?    @db.Timestamptz(3)
  sentAt             DateTime?    @db.Timestamptz(3)
  acceptedAt         DateTime?    @db.Timestamptz(3)
  rejectedAt         DateTime?    @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(3)
  createdById        String?      @db.Uuid
  updatedById        String?      @db.Uuid
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle            Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  items              QuoteItem[]
  acceptedServiceCase ServiceCase?
  createdBy          User?        @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?        @relation("QuoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, issuedOn])
  @@index([clientId, issuedOn])
  @@index([vehicleId])
  @@map("quotes")
}

model QuoteItem {
  id                  String   @id @default(uuid()) @db.Uuid
  quoteId             String   @db.Uuid
  serviceId           String?  @db.Uuid
  nameSnapshot        String
  descriptionSnapshot String?
  quantity            Decimal  @db.Decimal(12, 3)
  unitPriceUsd        Decimal  @db.Decimal(19, 2)
  discountUsd         Decimal  @default(0) @db.Decimal(19, 2)
  totalUsd            Decimal  @db.Decimal(19, 2)
  sortOrder           Int      @default(0)
  quote               Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service             Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([quoteId, sortOrder])
  @@index([serviceId])
  @@map("quote_items")
}

model Appointment {
  id              String                @id @default(uuid()) @db.Uuid
  serviceCaseId   String                @db.Uuid
  startAt         DateTime              @db.Timestamptz(3)
  endAt           DateTime              @db.Timestamptz(3)
  status          AppointmentStatus     @default(CONFIRMED)
  internalNotes   String?
  color           String?
  visibleToClient Boolean               @default(true)
  cancelledAt     DateTime?             @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  createdById     String?               @db.Uuid
  updatedById     String?               @db.Uuid
  serviceCase     ServiceCase           @relation(fields: [serviceCaseId], references: [id], onDelete: Restrict)
  services        AppointmentService[]
  employees       AppointmentEmployee[]
  createdBy       User?                 @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?                 @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  job             Job?

  @@index([startAt, endAt, status])
  @@index([serviceCaseId])
  @@map("appointments")
}

model AppointmentService {
  id                      String      @id @default(uuid()) @db.Uuid
  appointmentId           String      @db.Uuid
  serviceId               String?     @db.Uuid
  nameSnapshot            String
  durationMinutesSnapshot Int?
  sortOrder               Int         @default(0)
  appointment             Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service                 Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([appointmentId, sortOrder])
  @@index([serviceId])
  @@map("appointment_services")
}

model AppointmentEmployee {
  appointmentId String      @db.Uuid
  userId        String      @db.Uuid
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([appointmentId, userId])
  @@index([userId])
  @@map("appointment_employees")
}

model CalendarBlock {
  id          String    @id @default(uuid()) @db.Uuid
  startAt     DateTime  @db.Timestamptz(3)
  endAt       DateTime  @db.Timestamptz(3)
  allDay      Boolean   @default(false)
  reason      String
  color       String?
  notes       String?
  active      Boolean   @default(true)
  cancelledAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdBy   User?     @relation("CalendarBlockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?     @relation("CalendarBlockUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([startAt, endAt, active])
  @@map("calendar_blocks")
}

model Job {
  id                  String        @id @default(uuid()) @db.Uuid
  serviceCaseId       String        @db.Uuid
  originAppointmentId String?       @unique @db.Uuid
  performedAt         DateTime      @db.Timestamptz(3)
  notes               String?
  voidedAt            DateTime?     @db.Timestamptz(3)
  voidReason          String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)
  createdById         String?       @db.Uuid
  updatedById         String?       @db.Uuid
  serviceCase         ServiceCase   @relation(fields: [serviceCaseId], references: [id], onDelete: Restrict)
  originAppointment   Appointment?  @relation(fields: [originAppointmentId], references: [id], onDelete: Restrict)
  services            JobService[]
  employees           JobEmployee[]
  createdBy           User?         @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?         @relation("JobUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([performedAt])
  @@index([serviceCaseId, performedAt])
  @@index([voidedAt])
  @@map("jobs")
}

model JobService {
  id                  String   @id @default(uuid()) @db.Uuid
  jobId               String   @db.Uuid
  serviceId           String?  @db.Uuid
  nameSnapshot        String
  descriptionSnapshot String?
  sortOrder           Int      @default(0)
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  service             Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([jobId, sortOrder])
  @@index([serviceId])
  @@map("job_services")
}

model JobEmployee {
  jobId  String @db.Uuid
  userId String @db.Uuid
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([jobId, userId])
  @@index([userId])
  @@map("job_employees")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

model IdempotencyKey {
  id              String   @id @default(uuid()) @db.Uuid
  key             String
  operation       String
  actorId         String?  @db.Uuid
  actor           User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  requestHash     String
  resultReference String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@unique([operation, key])
  @@index([actorId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
