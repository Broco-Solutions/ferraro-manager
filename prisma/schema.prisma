generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
}

enum VehicleClass {
  SEDAN
  SUV
  PICKUP
  OTHER
}

enum ServiceVariantType {
  VEHICLE_CLASS
  MODEL_EXCEPTION
}

model User {
  id                       String            @id @default(uuid()) @db.Uuid
  name                     String
  email                    String            @unique
  emailVerified            Boolean           @default(false)
  image                    String?
  role                     UserRole          @default(STAFF)
  active                   Boolean           @default(true)
  lastLoginAt              DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  sessions                 Session[]
  accounts                 Account[]
  idempotency              IdempotencyKey[]
  clientsCreated           Client[]          @relation("ClientCreatedBy")
  clientsUpdated           Client[]          @relation("ClientUpdatedBy")
  vehiclesCreated          Vehicle[]         @relation("VehicleCreatedBy")
  vehiclesUpdated          Vehicle[]         @relation("VehicleUpdatedBy")
  serviceCategoriesCreated ServiceCategory[] @relation("ServiceCategoryCreatedBy")
  serviceCategoriesUpdated ServiceCategory[] @relation("ServiceCategoryUpdatedBy")
  servicesCreated          Service[]         @relation("ServiceCreatedBy")
  servicesUpdated          Service[]         @relation("ServiceUpdatedBy")
  serviceVariantsCreated   ServiceVariant[]  @relation("ServiceVariantCreatedBy")
  serviceVariantsUpdated   ServiceVariant[]  @relation("ServiceVariantUpdatedBy")

  @@index([active])
  @@map("users")
}

model Client {
  id              String    @id @default(uuid()) @db.Uuid
  displayName     String
  firstName       String?
  lastName        String?
  phone           String?
  normalizedPhone String?
  whatsapp        String?
  email           String?
  instagram       String?
  notes           String?
  active          Boolean   @default(true)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?   @db.Uuid
  updatedById     String?   @db.Uuid
  createdBy       User?     @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?     @relation("ClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  vehicles        Vehicle[]

  @@index([displayName])
  @@index([normalizedPhone])
  @@index([email])
  @@index([active, createdAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("clients")
}

model Vehicle {
  id             String        @id @default(uuid()) @db.Uuid
  clientId       String        @db.Uuid
  brand          String
  model          String
  version        String?
  year           Int?
  color          String?
  vehicleClass   VehicleClass?
  notes          String?
  coverObjectKey String?
  active         Boolean       @default(true)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?       @db.Uuid
  updatedById    String?       @db.Uuid
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy      User?         @relation("VehicleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?         @relation("VehicleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([clientId, active])
  @@index([brand, model])
  @@index([createdById])
  @@index([updatedById])
  @@map("vehicles")
}

model ServiceCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  createdBy   User?     @relation("ServiceCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?     @relation("ServiceCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  services    Service[]

  @@unique([name])
  @@index([active, sortOrder])
  @@map("service_categories")
}

model Service {
  id                       String           @id @default(uuid()) @db.Uuid
  categoryId               String           @db.Uuid
  name                     String
  internalDescription      String?
  commercialDescription    String?
  basePriceUsd             Decimal?         @db.Decimal(19, 2)
  estimatedDurationMinutes Int?
  imageObjectKey           String?
  sortOrder                Int              @default(0)
  active                   Boolean          @default(true)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  createdById              String?          @db.Uuid
  updatedById              String?          @db.Uuid
  category                 ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants                 ServiceVariant[]
  createdBy                User?            @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                User?            @relation("ServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([categoryId, name])
  @@index([active, sortOrder])
  @@index([categoryId, active])
  @@map("services")
}

model ServiceVariant {
  id                       String             @id @default(uuid()) @db.Uuid
  serviceId                String             @db.Uuid
  type                     ServiceVariantType
  label                    String
  vehicleClass             VehicleClass?
  matchBrand               String?
  matchModel               String?
  priceUsd                 Decimal            @db.Decimal(19, 2)
  estimatedDurationMinutes Int?
  priority                 Int                @default(0)
  active                   Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  createdById              String?            @db.Uuid
  updatedById              String?            @db.Uuid
  service                  Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdBy                User?              @relation("ServiceVariantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy                User?              @relation("ServiceVariantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([serviceId, active, type, priority])
  @@map("service_variants")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

model IdempotencyKey {
  id              String   @id @default(uuid()) @db.Uuid
  key             String
  operation       String
  actorId         String?  @db.Uuid
  actor           User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  requestHash     String
  resultReference String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@unique([operation, key])
  @@index([actorId])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
